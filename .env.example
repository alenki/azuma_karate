# Copy to .env.local and fill in. Nothing here is secret: every NEXT_PUBLIC_
# value is inlined into the JavaScript bundle and is readable by anyone who
# opens the page. The Telegram bot token is NOT here and must never be — it
# lives in a PHP file above the web root on the server, see
# public/api/config.example.php.

# The canonical origin. Until this is set, every absolute URL in the head
# (canonical, og:url, og:image) points at localhost. Required before launch.
NEXT_PUBLIC_SITE_URL=

# Where chapter 六 posts a заявка. Leave it UNSET in production: the default
# is the relative path /api/send.php, which is the relay shipped in public/.
#
# Set it to an EMPTY STRING to turn the relay off and restore what the sheet
# did before one existed — assemble the message, print it, and let the reader
# carry it into Telegram by hand. That is the right setting for `next dev`,
# where the .php is served as its own source text instead of being executed,
# and it is the honest setting for any deploy where the bot is not set up yet.
#
#   NEXT_PUBLIC_JOIN_ENDPOINT=
#
# Point it at a full URL only to test a laptop build against a deployed relay.
